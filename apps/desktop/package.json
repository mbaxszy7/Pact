{
  "name": "@pact/desktop",
  "version": "0.4.0",
  "private": true,
  "description": "Pact desktop shell",
  "license": "MIT",
  "author": "Pact contributors",
  "main": "./out/main/index.js",
  "scripts": {
    "brand": "node build/generate-brand-assets.mjs",
    "brand:win": "node build/generate-brand-assets.mjs --installer-artwork",
    "build": "pnpm brand && pnpm typecheck && electron-vite build",
    "dev": "pnpm brand && node build/launch-development.mjs dev",
    "dist:mac": "node ../../scripts/build-distribution.mjs --profile production-local --channel stable --platform darwin",
    "dist:win": "node ../../scripts/build-distribution.mjs --profile production-local --channel stable --platform win32",
    "dist:win:preview": "pnpm build && electron-builder --win nsis --x64 --publish never --config electron-builder.win-preview.yml",
    "package:dir": "node ../../scripts/build-distribution.mjs --channel dev --dir",
    "package:dir:local": "node ../../scripts/build-distribution.mjs --profile production-local --channel stable --dir",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "start": "node build/launch-development.mjs preview",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.286",
    "@electron-toolkit/utils": "4.0.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@pact/agent-runtime": "workspace:*",
    "@pact/contracts": "workspace:*",
    "@pact/persistence": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-virtual": "3.14.13",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "gitdiff-parser": "0.3.1",
    "lucide-react": "1.46.0",
    "monaco-editor": "0.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.12.4",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "0.35.5",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  },
  "optionalDependencies": {
    "@img/sharp-win32-arm64": "0.35.5",
    "@img/sharp-win32-x64": "0.35.5"
  }
}
